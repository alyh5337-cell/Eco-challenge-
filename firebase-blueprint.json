{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile, progression, eco score, and inventory.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 100 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "score": { "type": "number" },
        "currentStreak": { "type": "number" },
        "lastActionDate": { "type": "string", "maxLength": 100 },
        "lastLoginDate": { "type": "string", "maxLength": 50 },
        "lastCheckinDate": { "type": "string", "maxLength": 50 },
        "lastCheckinTimestamp": { "type": "number" },
        "totalCheckins": { "type": "number" },
        "streakTheme": { "type": "string", "maxLength": 20 },
        "equippedBadge": { "type": "string", "maxLength": 500 },
        "isBanned": { "type": "boolean" },
        "banReason": { "type": "string", "maxLength": 500 },
        "inventory": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "displayName"]
    },
    "Squad": {
      "title": "Squad",
      "description": "Eco squad group information and team score.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "joinCode": { "type": "string", "maxLength": 30 },
        "isPrivate": { "type": "boolean" },
        "leaderId": { "type": "string", "maxLength": 128 },
        "leaderName": { "type": "string", "maxLength": 100 },
        "totalScore": { "type": "number" },
        "badgeIcon": { "type": "string", "maxLength": 50 },
        "memberCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "name", "leaderId"]
    },
    "SquadMessage": {
      "title": "SquadMessage",
      "description": "Messages sent inside squad chat channels.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "squadId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userAvatar": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 2000 },
        "mediaUrl": { "type": "string", "maxLength": 1000 },
        "mediaType": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "squadId", "userId", "userName", "content"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "Public eco achievements feed post shared with the community.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorAvatar": { "type": "string", "maxLength": 500 },
        "caption": { "type": "string", "maxLength": 2000 },
        "mediaUrl": { "type": "string", "maxLength": 1000 },
        "mediaType": { "type": "string", "maxLength": 50 },
        "likesCount": { "type": "number" },
        "isFlagged": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "userId", "authorName", "caption"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profiles, streaks, eco points, and inventory."
    },
    "/squads/{squadId}": {
      "schema": "Squad",
      "description": "Stores eco squads and group details."
    },
    "/squads/{squadId}/messages/{messageId}": {
      "schema": "SquadMessage",
      "description": "Stores chat messages in squads."
    },
    "/community_posts/{postId}": {
      "schema": "CommunityPost",
      "description": "Stores shared community eco deeds and photos."
    }
  }
}
