# ==========================================
# Google Cloud Build & Cloud Run Ignore File
# Prevents uploading massive local folders
# ==========================================
.gcloudignore
.git
.github
node_modules/
dist/
build/
.next/
out/
.cache/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.md
.env*.local
.aistudio/
