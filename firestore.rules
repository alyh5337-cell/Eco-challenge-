rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             (!('score' in data) || data.score is number) &&
             (!('currentStreak' in data) || data.currentStreak is number) &&
             (!('lastCheckinDate' in data) || (data.lastCheckinDate is string && data.lastCheckinDate.size() <= 50)) &&
             (!('lastCheckinTimestamp' in data) || data.lastCheckinTimestamp is number) &&
             (!('totalCheckins' in data) || data.totalCheckins is number);
    }

    function isValidSquad(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.leaderId is string && data.leaderId.size() <= 128;
    }

    function isValidMessage(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.content is string && data.content.size() <= 2000 &&
             data.userId is string && data.userId.size() <= 128;
    }

    function isValidPost(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.caption is string && data.caption.size() <= 2000 &&
             data.userId is string && data.userId.size() <= 128;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().id == userId;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().id == existing().id;
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // Squads Collection
    match /squads/{squadId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(squadId) && isValidSquad(incoming()) && incoming().leaderId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(squadId) && isValidSquad(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(squadId) && existing().leaderId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming()) && incoming().userId == request.auth.uid;
        allow delete: if isSignedIn() && isValidId(messageId) && existing().userId == request.auth.uid;
      }
    }

    // Community Posts
    match /community_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(postId) && isValidPost(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(postId) && (
        (existing().userId == request.auth.uid && isValidPost(incoming()) && incoming().id == existing().id) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'isLiked'])
      );
      allow delete: if isSignedIn() && isValidId(postId) && existing().userId == request.auth.uid;
    }
  }
}
